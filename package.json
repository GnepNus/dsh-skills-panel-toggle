{
  "name": "dsh-skills-panel-toggle",
  "version": "1.0.0",
  "description": "Sidebar panel to browse every skill and disable or enable it.",
  "type": "module",
  "license": "MIT",
  "author": "GnepNus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GnepNus/dsh-skills-panel-toggle.git"
  },
  "homepage": "https://github.com/GnepNus/dsh-skills-panel-toggle#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skills"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
